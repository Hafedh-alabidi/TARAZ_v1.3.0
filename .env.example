# ============================================================
# طراز — متغيرات بيئة Docker Compose للإنتاج
# انسخ هذا الملف إلى .env (بجانب docker-compose.yml) واملأ القيم
# لا ترفع ملف .env إلى أي مستودع أو مشاركة
# ============================================================

# --- إلزامي: سرّ عشوائي (50+ حرفاً) ---
# ولّده بالأمر: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=ضع-هنا-مفتاحاً-عشوائياً-طويلاً-مولداً-بالأمر-أعلاه

# --- إلزامي: نطاقاتك الحقيقية (مفصولة بفواصل، بدون *) ---
ALLOWED_HOSTS=taraz.com,www.taraz.com,admin.taraz.com

# --- إلزامي: نطاقات الواجهات الأمامية (HTTPS بعد تفعيل الشهادات) ---
CORS_ALLOWED_ORIGINS=https://taraz.com,https://www.taraz.com,https://admin.taraz.com

# --- إلزامي: مصادر CSRF الموثوقة (نفس نطاقاتك بمخطط https) ---
CSRF_TRUSTED_ORIGINS=https://taraz.com,https://www.taraz.com,https://admin.taraz.com

# --- إلزامي: كلمة مرور قاعدة البيانات (قوية وعشوائية) ---
DB_PASSWORD=ضع-كلمة-مرور-قوية-عشوائية

# --- اختياري ---
DB_NAME=taraz
DB_USER=taraz

# المنطقة الزمنية (اليمن)
TIME_ZONE=Asia/Aden

# اجعلها True بعد تفعيل HTTPS في nginx (راجع nginx-frontend.conf و DEPLOYMENT.md)
SECURE_SSL_REDIRECT=False

# ============================================================
# بوابة الدفع
# ============================================================
# 'moyasar'    = إنتاج حقيقي (يتطلب المفاتيح أدناه من dashboard.moyasar.com)
# 'simulated'  = بوابة تجريبية للمعاينة والتدريب (الوضع الحالي)
# 'none'       = الدفع عند الاستلام والتحويل البنكي فقط
TARAZ_PAYMENT_PROVIDER=simulated

# مفاتيح مويسر — تُعبأ فقط عند TARAZ_PAYMENT_PROVIDER=moyasar
# تدعم البطاقات: جيب / Visa / Mastercard / Apple Pay
MOYASAR_SECRET_KEY=
MOYASAR_PUBLISHABLE_KEY=

# ============================================================
# البريد الإلكتروني (مطلوب لاستعادة كلمة المرور وإشعارات الطلبات)
# ============================================================
# مثال لـ Gmail: EMAIL_HOST=smtp.gmail.com  EMAIL_PORT=587
# وكلمة مرور التطبيق (App Password) وليس كلمة مرور الحساب
# أو استخدم مزوداً مثل Brevo / SendGrid / Mailgun
EMAIL_BACKEND=smtp
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=no-reply@taraz.com
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=طراز <no-reply@taraz.com>

# ============================================================
# بيانات المتجر والدعم
# ============================================================
TARAZ_SELLER_NAME=متجر طراز
TARAZ_VAT_NUMBER=100200300
TARAZ_SUPPORT_EMAIL=DigitalCreativityteam5@gmail.com
TARAZ_SUPPORT_PHONE=00967 777279161

# ============================================================
# الأعمال: الضريبة والشحن والعمولات
# ============================================================
# الضريبة العامة على المبيعات (اليمن) = 5%
TARAZ_TAX_RATE=0.05
TARAZ_SHIPPING_FLAT=25
TARAZ_FREE_SHIPPING_THRESHOLD=500
TARAZ_COMMISSION_RATE=5.0
TARAZ_MAX_DISCOUNT_RATIO=0.5

# ============================================================
# الأمان والجلسات
# ============================================================
TARAZ_TOKEN_TTL_DAYS=30
THROTTLE_AUTH=10/min

# عنوان لوحة تحكم Django تحت مساس (مثال: لوحة التحكم على /panel/ بدل /admin/)
# غيّره بعد أول إطلاق لصعوبة اكتشافه
ADMIN_URL_PATH=admin
