# طراز — متغيرات بيئة المتجر الإلكتروني (Vite)
# انسخه إلى .env.local للتطوير أو مرّره عند بناء Docker

# عنوان الـ API — في التطوير يعمل proxy الـ vite تلقائياً (اتركه فارغاً)
# في الإنتاج مع nginx: يُخدم من نفس النطاق (/api) فاتركه فارغاً أيضاً
#VITE_API_URL=

# رابط لوحة الإدارة (تطبيق سطح المكتب) الذي يظهر لموظفي النظام في قائمة الحساب
# ضع عنوان نطاق الإدارة الفعلي في الإنتاج
VITE_DESKTOP_URL=http://localhost:3000
