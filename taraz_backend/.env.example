# ============================================================
# طراز — نموذج متغيرات البيئة (نسخة التطوير المحلي)
# انسخه إلى .env وعدّل القيم:  cp .env.example .env
#
# ✅ هذا ملف نموذجي — قيمه للتطوير فقط ولا تصلح للإنتاج.
# للإنتاج: استخدم .env.example في جذر المشروع مع docker-compose
# ولا تشغّل أبداً بمفتاح development مع DEBUG=False — الخادم يرفض الإقلاع.
# ============================================================

# --- الأمان ---
# أنشئ مفتاحاً سرياً قوياً: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-with-a-strong-random-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- قاعدة البيانات ---
# للتطوير: SQLite (اترك الافتراضي) | للإنتاج: PostgreSQL
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=taraz
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- CORS (واجهات الواجهة الأمامية) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# --- المنطقة الزمنية (اليمن) ---
TIME_ZONE=Asia/Aden

# --- إعدادات الأعمال ---
# الضريبة العامة على المبيعات (اليمن) = 5%
TARAZ_TAX_RATE=0.05
TARAZ_SHIPPING_FLAT=25
TARAZ_FREE_SHIPPING_THRESHOLD=500
TARAZ_COMMISSION_RATE=5.0
# سقف الخصم الذي يجوز لموظف تطبيقه (نسبة من قيمة الطلب)
TARAZ_MAX_DISCOUNT_RATIO=0.5

# --- حدود الطلبات (Throttling) ---
THROTTLE_ANON=60/min
THROTTLE_USER=600/min
# حد مشدد لمسارات الدخول/التسجيل/استعادة كلمة المرور/الرموز ضد التخمين
THROTTLE_AUTH=10/min

# --- سياسة الجلسات ---
# صلاحية رمز المصادقة بالأيام — يُبطَل بعدها تلقائياً
TARAZ_TOKEN_TTL_DAYS=30

# --- السجلات ---
LOG_LEVEL=INFO

# ============================================================
# ✅ البريد الإلكتروني (إشعارات + استعادة كلمة المرور)
# للتطوير يُطبع البريد في طرفية الخادم (console) — للإنتاج فعّل SMTP:
# ============================================================
# EMAIL_BACKEND=smtp
# EMAIL_HOST=smtp.yourprovider.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=no-reply@yourdomain.com
# EMAIL_HOST_PASSWORD=changeme
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=TARAZ <no-reply@yourdomain.com>

# عنوان الواجهة الأمامية — لبناء روابط استعادة كلمة المرور في البريد
FRONTEND_URL=http://localhost:3000

# ============================================================
# ✅ الفاتورة الإلكترونية (QR بترميز TLV Base64)
# بيانات البائع التي تُرمَّز داخل QR الفاتورة — للأهمية الضريبية
# استبدل الرقم برقمك الفعلي لدى مصلحة الضرائب اليمنية
# ============================================================
TARAZ_SELLER_NAME=متجر طراز
TARAZ_VAT_NUMBER=100200300

# ============================================================
# ✅ بوابة الدفع الإلكتروني
#   simulated : بوابة محاكاة للتدريب والقبول (بطاقات تجريبية فقط)
#   moyasar   : تكامل حقيقي مع مويسر — يتطلب المفاتيح أدناه
#   none      : بلا دفع إلكتروني (دفع عند الاستلام/تحويل فقط)
# ============================================================
TARAZ_PAYMENT_PROVIDER=simulated
# MOYASAR_SECRET_KEY=sk_live_XXXXXXXXXXXXXXXX
# MOYASAR_PUBLISHABLE_KEY=pk_live_XXXXXXXXXXXXXXXX

# --- بيانات الدعم (تُنشر للواجهات عبر /api/config/) ---
TARAZ_SUPPORT_EMAIL=DigitalCreativityteam5@gmail.com
TARAZ_SUPPORT_PHONE=00967 777279161

# --- إنتاج فقط ---
SECURE_SSL_REDIRECT=True
