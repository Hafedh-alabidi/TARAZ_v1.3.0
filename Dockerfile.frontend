# ============================================================
# طراز — بناء واجهات React للإنتاج
# ============================================================
FROM node:22-alpine AS build

ARG APP=marketplace
WORKDIR /app

# ✅ (P2) npm ci بدل npm install — تثبيت قابل للتكرار من package-lock.json
COPY taraz_${APP}/package.json taraz_${APP}/package-lock.json ./
RUN npm ci

COPY taraz_${APP}/ ./
# الواجهات تتصل بالـ API عبر nginx proxy في الإنتاج
ARG VITE_API_URL=/api
RUN npm run build

# ============================================================
# خادم nginx لخدمة الواجهة + توجيه الـ API
# ============================================================
FROM nginx:alpine

ARG APP=marketplace
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx-frontend.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
